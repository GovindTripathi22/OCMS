# OCMS Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, good for local dev):
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production):
# DATABASE_URL="postgresql://user:password@host:5432/ocms"

# ─── Auth (Auth.js / NextAuth) ────────────────────────────────────────────────
# REQUIRED. Generate a secure secret:
#   openssl rand -base64 32
AUTH_SECRET=""

# REQUIRED in production. Set to your deployment URL:
#   https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Optional: Local File Sync ────────────────────────────────────────────────
# Absolute path to the root of the project you want to edit locally.
# Leave blank to use process.cwd() (only safe in local dev, never in production).
LOCAL_WORKSPACE_PATH=""

# ─── Optional: Guest / Demo Access ───────────────────────────────────────────
# Set to "true" ONLY in local development to bypass GitHub auth.
# This is ALWAYS disabled in production regardless of this setting.
ALLOW_GUEST_ACCESS="false"

# ─── Optional: SSRF Protection Bypass ────────────────────────────────────────
# Set to "true" ONLY in local dev to allow scraping localhost URLs.
# Never set this in production.
ALLOW_LOCAL_SSRF="false"

# ─── Optional: AI / Texture Generation ───────────────────────────────────────
# Required only if you use the Replicate-powered texture generation feature.
REPLICATE_API_TOKEN=""
